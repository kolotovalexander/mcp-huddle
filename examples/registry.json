[
  {
    "name": "Codex",
    "cmd": [
      "codex",
      "-a", "never",
      "exec",
      "--disable", "guardian_approval",
      "--json",
      "--output-last-message", "{last_message}",
      "-c", "model_reasoning_effort=\"medium\"",
      "-s", "danger-full-access",
      "{brief}"
    ],
    "enabled": true
  },
  {
    "name": "Antigravity",
    "cmd": [
      "agy",
      "--dangerously-skip-permissions",
      "--print-timeout", "15m",
      "-p", "{brief}"
    ],
    "enabled": true
  },
  {
    "name": "LocalLLM",
    "cmd": [
      "python",
      "-m", "mcp_huddle.openai_compatible_runner",
      "--agent", "LocalLLM",
      "--base-url", "http://127.0.0.1:11434/v1",
      "--model", "qwen2.5-coder",
      "--brief", "{brief}"
    ],
    "enabled": true,
    "probe_url": "http://127.0.0.1:11434/v1/models",
    "requires_model": "qwen2.5-coder",
    "probe_chat_url": "http://127.0.0.1:11434/v1/chat/completions",
    "probe_chat_model": "qwen2.5-coder",
    "probe_timeout_sec": 0.8
  },
  {
    "name": "Claude Opus 5 (direct review)",
    "cmd": [
      "claude", "--bare", "--restricted", "--strict-mcp-config",
      "--mcp-config", "{\"mcpServers\":{\"huddle\":{\"type\":\"http\",\"url\":\"http://127.0.0.1:8014/mcp\"}}}",
      "--model", "claude-opus-5", "-p", "{brief}"
    ],
    "enabled": false,
    "auto": false,
    "profile": "claude-opus-direct-review"
  }
]
