<mxfile host="app.diagrams.net" modified="2026-09-24T16:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="one" name="Huddle Swarm · единая схема"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="3600" math="0" shadow="0"><root><mxCell id="r0"/><mxCell id="r1" parent="r0"/>
<mxCell id="title" value="Huddle Swarm · единая схема работы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFF;fontSize=28;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="25" width="1540" height="70" as="geometry"/></mxCell>
<mxCell id="intro" value="Организатор передаёт цель, ограничения и рабочую папку. Huddle создаёт комнату, проверяет настройки и ведёт участников по одному из четырёх режимов. Цвета: зелёный человек; синий механика; оранжевый пилот; фиолетовый будущее; красный граница." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#829AB1;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="115" width="1540" height="82" as="geometry"/></mxCell>
<mxCell id="in" value="Запрос организатора&lt;br&gt;Цель, требования пользователя, cwd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="225" width="480" height="120" as="geometry"/></mxCell>
<mxCell id="jev" value="Jev — помощник структурированного выбора&lt;br&gt;Режим, роли, модели, права — планируемая рекомендация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7753AA;strokeWidth=2;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="560" y="225" width="480" height="120" as="geometry"/></mxCell>
<mxCell id="cfg" value="Конфигурация комнаты&lt;br&gt;Уникальные ID сессий, права, режим, shared copy/sub-worktree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1" tooltip="MCP «Создать комнату пилота» — swarm_pilot_create(..., owner_pid=0). Обычная Huddle: room_create → room_invite."><mxGeometry x="1090" y="225" width="480" height="120" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#268257;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="in" target="jev"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7753AA;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="jev" target="cfg"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="common" value="Общий цикл: ответственность → чтение контекста → действие → сообщение/факт/решение → явное done → условие финиша → итог" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1" tooltip="MCP: messages_read, message_post, swarm_pilot_record, swarm_pilot_round_done."><mxGeometry x="30" y="375" width="1540" height="92" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="cfg" target="common"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c" value="1 · Совет · последовательные ответы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="500" width="1540" height="52" as="geometry"/></mxCell>
<mxCell id="cx" value="Каждый читает предыдущие ответы; последнее слово и итог — организатор." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#829AB1;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="560" width="1540" height="54" as="geometry"/></mxCell>
<mxCell id="c0" value="Адресный ход&lt;br&gt;swarm_pilot_pump" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="625" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="c1" value="Ответ + явное done&lt;br&gt;message_post → round_done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="565" y="625" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="c2" value="Есть ещё участники?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="1070" y="625" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="cy" value="Да → следующий читает ленту и отвечает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="780" width="700" height="105" as="geometry"/></mxCell>
<mxCell id="cn" value="Нет → организатор публикует итог" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1" tooltip="MCP «Опубликовать итог комнаты» — swarm_pilot_finish(..., member=&quot;Организатор&quot;)."><mxGeometry x="840" y="780" width="700" height="105" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
