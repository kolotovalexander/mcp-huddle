<mxCell id="cs" value="Пилот: отдельные CLI-ходы, owner_pid=0. Живой PTY и добавление сообщения в активный ход — после пилота." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#AD5A3B;strokeWidth=2;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="910" width="1480" height="65" as="geometry"/></mxCell>
<mxCell id="t" value="2 · Команда · параллельные части" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="995" width="1540" height="52" as="geometry"/></mxCell>
<mxCell id="tx" value="Каждый объявляет ответственность; reporter публикует итог после проверки всех нужных частей." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#829AB1;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="1055" width="1540" height="54" as="geometry"/></mxCell>
<mxCell id="t0" value="Ответственность&lt;br&gt;swarm_pilot_record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="1130" width="470" height="105" as="geometry"/></mxCell>
