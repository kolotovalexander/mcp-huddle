        </mxCell>
        <mxCell id="future_head" value="ПОСЛЕ ПИЛОТА · следующие улучшения, пока не единый работающий поток" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7753AA;strokeWidth=2;fontColor=#18212B;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
