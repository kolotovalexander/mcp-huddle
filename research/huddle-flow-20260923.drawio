<mxCell id="tm" value="Нет → назначить владельца и вернуть в дорожку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="720" y="1425" width="380" height="95" as="geometry"/></mxCell>
