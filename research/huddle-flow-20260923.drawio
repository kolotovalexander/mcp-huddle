<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-09-23T16:57:31.160642+00:00" agent="Codex" version="24.7.17" type="device">
  <diagram id="page1" name="1 · Как Huddle работает сейчас">
    <mxGraphModel dx="2100" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1370" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title1" value="КАК РАБОТАЕТ HUDDLE СЕЙЧАС" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=27;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" link="https://github.com/kolotovalexander/AgentSync/issues/361">
          <mxGeometry x="35" y="25" width="2030" height="60" as="geometry" />
        </mxCell>
        <mxCell id="intro1" value="Пример: пользователь просит разобраться в задаче. Организатор — главный агент — открывает комнату Huddle, приглашает коллег и получает их ответы. Человек видит разговор в дашборде." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="110" width="2030" height="95" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="Зелёный — человек или организатор | Синий — работает сейчас | Серый — пояснение и граница | Оранжевый — ограничения" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="225" width="2030" height="48" as="geometry" />
        </mxCell>
        <mxCell id="human" value="1 · ПОЛЬЗОВАТЕЛЬ&lt;br&gt;Ставит цель и ограничения&lt;br&gt;например: «сравните варианты»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="335" width="305" height="135" as="geometry" />
        </mxCell>
        <mxCell id="organizer" value="2 · ОРГАНИЗАТОР&lt;br&gt;Решает, кого спросить&lt;br&gt;и формулирует общий вопрос" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="В обычной комнате организатор вызывает инструменты Huddle через MCP.">
          <mxGeometry x="438" y="335" width="325" height="135" as="geometry" />
        </mxCell>
        <mxCell id="create" value="3 · ДВЕ КОМАНДЫ HUDDLE&lt;br&gt;Сначала «Создать комнату»&lt;br&gt;потом «Пригласить участника»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Два отдельных MCP-вызова: room_create(name, owner, owner_pid, cwd) создаёт комнату; room_invite(room_id, agent_name, by=owner) добавляет участника. Приглашение само по себе не запускает ход.">
          <mxGeometry x="860" y="335" width="330" height="135" as="geometry" />
        </mxCell>
        <mxCell id="room" value="4 · КОМНАТА&lt;br&gt;Общая лента сообщений&lt;br&gt;Сохраняется на диске" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Хранилище: meta.json, messages.jsonl и логи агентов. MCP-инструменты: message_post, messages_read.">
          <mxGeometry x="1288" y="335" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="5 · ДАШБОРД&lt;br&gt;Человек читает разговор&lt;br&gt;и при необходимости пишет сам" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" link="http://127.0.0.1:8014/dashboard" tooltip="Локальный дашборд Huddle: http://127.0.0.1:8014/dashboard">
          <mxGeometry x="1725" y="335" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="задача" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="human" target="organizer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="organizer" target="create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="создаёт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="create" target="room">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="виден в" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="room" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ask" value="6 · HUDDLE ПЕРЕДАЁТ ВОПРОС&lt;br&gt;Адресует запрос выбранным участникам.&lt;br&gt;Профиль задаёт CLI и доступные права." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Технически: message_post(kind=request) и механизм spawn/wake; профиль берётся из реестра Huddle.">
          <mxGeometry x="390" y="585" width="470" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="7 · АГЕНТ ДЕЛАЕТ ХОД&lt;br&gt;Claude, Codex, Antigravity или OpenCode&lt;br&gt;читает комнату и отвечает." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Сейчас дочерний CLI запускается как отдельный процесс на ход. stdin=DEVNULL; интерактивный PTY внутри Huddle ещё не реализован.">
          <mxGeometry x="945" y="585" width="470" height="145" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="8 · ОТВЕТ В КОМНАТЕ&lt;br&gt;Результат сохраняется в ленте.&lt;br&gt;Другие агенты увидят его при чтении." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2465A8;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Технически: message_post(kind=result) и messages_read. Адресный новый вопрос может пробудить агента ещё раз.">
          <mxGeometry x="1540" y="585" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="вопрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="room" target="ask">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1330" y="525" />
              <mxPoint x="625" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="запуск" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ask" target="cli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="результат" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cli" target="answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="сохраняет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2465A8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="answer" target="room">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1780" y="525" />
              <mxPoint x="1542" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="store" value="ЧТО СОХРАНЯЕТСЯ&lt;br&gt;Комната, сообщения и состояние находятся в файлах Huddle. Дашборд и MCP читают одни и те же данные; окно организатора не является хранилищем комнаты." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="885" width="980" height="145" as="geometry" />
        </mxCell>
        <mxCell id="limit" value="ЧТО ПОКА НЕ РАБОТАЕТ&lt;br&gt;Новый комментарий не попадает в уже идущий ход агента. Huddle запускает процесс на ход или возобновляет сессию позднее; живым терминалом внутри Huddle он пока не управляет." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#AD5A3B;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="885" width="980" height="145" as="geometry" />
        </mxCell>
        <mxCell id="permissions" value="КТО РЕШАЕТ ПРО ДОСТУП&lt;br&gt;Для команд этой задачи я запрашиваю обычный доступ к конкретному действию, а проверка Codex может разрешить или отклонить его. У дочерних агентов Huddle — собственные разрешения CLI; профиль комнаты не отменяет защиту среды." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="1090" width="2025" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tech1" value="ТЕХНИЧЕСКИЕ ИМЕНА СКРЫТЫ В ПОДСКАЗКАХ: наведите курсор на блоки «Команда Huddle», «Комната», «Huddle передаёт вопрос», «Агент делает ход». Названия на схеме описывают действия по-человечески." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="1270" width="2025" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page2" name="2 · Четыре режима и развитие">
    <mxGraphModel dx="2100" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1630" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="КАК ОРГАНИЗАТОР ВЫБИРАЕТ РЕЖИМ КОМНАТЫ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=27;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" link="https://github.com/kolotovalexander/AgentSync/issues/361">
          <mxGeometry x="35" y="25" width="2030" height="60" as="geometry" />
        </mxCell>
        <mxCell id="intro2" value="Режим — это правило работы одной комнаты: кто отвечает первым, могут ли участники работать одновременно и кто публикует итог. Состав и цель передаёт организатор." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="105" width="2030" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Зелёный — организатор | Оранжевый — код пилота, живой цикл не доказан | Фиолетовый — запланировано" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#596776;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="220" width="2030" height="55" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="1 · ОРГАНИЗАТОР&lt;br&gt;Передаёт цель, пожелания,&lt;br&gt;ограничения, состав и режим." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="335" width="550" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pilot_create" value="2 · HUDDLE СОЗДАЁТ КОМНАТУ&lt;br&gt;Записывает режим, участников,&lt;br&gt;рабочую папку и цель." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Технический MCP-инструмент пилота: swarm_pilot_create(name, organizer, goal, mode, members, cwd, workspace_strategy, start).">
          <mxGeometry x="775" y="335" width="550" height="145" as="geometry" />
        </mxCell>
        <mxCell id="dispatcher" value="3 · HUDDLE РАССЫЛАЕТ ВОПРОСЫ&lt;br&gt;Адресует их по правилу выбранного режима.&lt;br&gt;Профили агентов задаются явно." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Технически: swarm_pilot_pump. Совет и Эстафета — последовательно; Команда и Рой — параллельно.">
          <mxGeometry x="1515" y="335" width="550" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="goal" target="pilot_create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="режим" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pilot_create" target="dispatcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="council" value="СОВЕТ&lt;br&gt;Когда нужно обсудить решение.&lt;br&gt;Агенты отвечают по очереди.&lt;br&gt;Каждый видит предыдущие ответы.&lt;br&gt;Итог говорит организатор." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Пилотный режим. Ответ: message_post(kind=result); завершение своей части: swarm_pilot_round_done.">
          <mxGeometry x="35" y="660" width="485" height="235" as="geometry" />
        </mxCell>
        <mxCell id="mode0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dispatcher" target="council">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1790" y="570" />
              <mxPoint x="277" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="team" value="КОМАНДА&lt;br&gt;Когда части независимы.&lt;br&gt;Агенты работают одновременно.&lt;br&gt;Каждый объявляет свою часть.&lt;br&gt;Итог собирает назначенный участник." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Пилотный режим. Ответ: message_post(kind=result); завершение своей части: swarm_pilot_round_done.">
          <mxGeometry x="550" y="660" width="485" height="235" as="geometry" />
        </mxCell>
        <mxCell id="mode1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dispatcher" target="team">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1790" y="570" />
              <mxPoint x="792" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="relay" value="ЭСТАФЕТА&lt;br&gt;Когда шаги зависят друг от друга.&lt;br&gt;Следующий начинает после передачи.&lt;br&gt;Состояние принимается явно.&lt;br&gt;Итог — последний участник или назначенный автор." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Пилотный режим. Ответ: message_post(kind=result); завершение своей части: swarm_pilot_round_done.">
          <mxGeometry x="1065" y="660" width="485" height="235" as="geometry" />
        </mxCell>
        <mxCell id="mode2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dispatcher" target="relay">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1790" y="570" />
              <mxPoint x="1307" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="swarm" value="РОЙ&lt;br&gt;Когда нужна общая работа и спор.&lt;br&gt;Агенты общаются и работают параллельно.&lt;br&gt;Сами делят ответственность.&lt;br&gt;Итог — назначенный участник." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Пилотный режим. Ответ: message_post(kind=result); завершение своей части: swarm_pilot_round_done.">
          <mxGeometry x="1580" y="660" width="485" height="235" as="geometry" />
        </mxCell>
        <mxCell id="mode3" value="" style="exitX=0.56;exitY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B87508;strokeWidth=2;endArrow=block;endFill=1;fontColor=#18212B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dispatcher" target="swarm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1822" y="570" />
              <mxPoint x="1822" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="round" value="4 · УЧАСТНИК ОТВЕЧАЕТ И ЗАКРЫВАЕТ СВОЮ ЧАСТЬ&lt;br&gt;Одно сообщение не завершает раунд. После ответа участник явно отмечает готовность; Huddle решает, кого спросить дальше. В Совете последнее слово у организатора, в остальных режимах — у назначенного автора итога." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#18212B;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1" tooltip="Технически: message_post(result) → swarm_pilot_round_done; итог: swarm_pilot_finish. Роль reporter объявляется через swarm_pilot_record.">
          <mxGeometry x="225" y="960" width="1650" height="135" as="geometry" />
        </mxCell>
