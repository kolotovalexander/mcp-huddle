<mxCell id="ts" value="Пилот: reporter завершает после readiness. Автоматический merge, субагенты и замена выбывшего — позже." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#AD5A3B;strokeWidth=2;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="1590" width="1480" height="65" as="geometry"/></mxCell>
