<mxCell id="swarm_intro" value="Участники сами распределяют ответственность, согласуют файлы и публикуют важные решения; организатор получает итог." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#829AB1;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="30" y="2520" width="1540" height="54" as="geometry"/></mxCell>
<mxCell id="s0" value="Соглашение до работы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="2585" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="s1" value="Общая лента и адресные вопросы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="565" y="2585" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="s2" value="Взять ответственность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="1070" y="2585" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="s12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sq1" value="У каждой части есть владелец?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="2740" width="400" height="95" as="geometry"/></mxCell>
<mxCell id="sf" value="Нет → назначить владельца и вернуться" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="2880" width="600" height="95" as="geometry"/></mxCell>
<mxCell id="sq2" value="Есть конфликт файлов?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="720" y="2740" width="400" height="95" as="geometry"/></mxCell>
<mxCell id="sf2" value="Да → общая папка/sub-worktree и решение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="720" y="2880" width="400" height="95" as="geometry"/></mxCell>
<mxCell id="sq3" value="Есть ошибка или лимит?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#B87508;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="1130" y="2740" width="410" height="95" as="geometry"/></mxCell>
<mxCell id="swarm_exception" value="Да → отдельное исключение; автозамена позже" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#AD5A3B;strokeWidth=2;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="1130" y="2880" width="410" height="95" as="geometry"/></mxCell>
<mxCell id="sr" value="Нет → reporter проверяет ответственность, решения и файлы и публикует итог" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F5EC;strokeColor=#268257;strokeWidth=2;fontColor=#102A43;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="720" y="3020" width="820" height="95" as="geometry"/></mxCell>
<mxCell id="s3q" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="r1" source="s2" target="sq1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sqn" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="sq1" target="sf"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sqy" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#268257;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="sq1" target="sq2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sq2y" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B87508;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="sq2" target="sf2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sq2n" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#268257;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="sq2" target="sq3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sq3y" value="да: исключение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AD5A3B;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF" edge="1" parent="r1" source="sq3" target="swarm_exception"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sq3n" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#268257;endArrow=block;endFill=1;fontColor=#243B53;fontSize=15;labelBackgroundColor=#FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="r1" source="sq3" target="sr"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ss" value="Пилот: ошибка/лимит — отдельная ветка, не ответ на конфликт файлов. Живой PTY, субагенты с правами/видимостью, preflight и восстановление — после пилота." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#AD5A3B;strokeWidth=2;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle" vertex="1" parent="r1"><mxGeometry x="60" y="3160" width="1480" height="65" as="geometry"/></mxCell>
<mxCell id="bottom" value="&lt;b&gt;Общие параметры и команды Huddle&lt;/b&gt;&lt;br&gt;Сессия: уникальный ID · точная модель и уровень рассуждения · чтение/запись · sandbox или обычная среда · рабочий каталог.&lt;br&gt;Файлы: общая копия или sub-worktree; участники сами согласуют конфликт.&lt;br&gt;&lt;b&gt;Обычная комната&lt;/b&gt;: «Создать комнату» room_create → «Пригласить участника» room_invite → «Опубликовать сообщение» message_post → «Прочитать разговор» messages_read.&lt;br&gt;&lt;b&gt;Пилот&lt;/b&gt;: «Создать комнату пилота» swarm_pilot_create → «Запустить ход» swarm_pilot_pump → «Записать факт/решение/ответственность» swarm_pilot_record.&lt;br&gt;Затем: «Завершить часть» swarm_pilot_round_done → «Посмотреть состояние» swarm_pilot_status → «Опубликовать итог» swarm_pilot_finish.&lt;br&gt;&lt;b&gt;Проверка пилота&lt;/b&gt;: четыре короткие комнаты; вопрос → ответ → ответственность → done → итог правильной стороны.&lt;br&gt;owner_pid=0: комната не зависит от живого процесса организатора." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#829AB1;fontColor=#243B53;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=16" vertex="1" parent="r1"><mxGeometry x="30" y="3265" width="1540" height="300" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
